# Copy to .env.local. Defaults target the restaurant-pos docker-compose stack.

# Postgres connection string. The POS docker-compose exposes Postgres on
# localhost:5432 with these credentials.
DATABASE_URL="postgresql://posuser:pospass123@localhost:5432/restaurant_pos"

# HS256 signing key for the staff JWT (used by jose).
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# Spring Boot POS URL (container exposes 8090 on the host).
SPRING_BOOT_URL="http://localhost:8090"

# POS Integration check
# Set to "false" only for a cloud deployment with no POS: seat, fire and
# table-status actions are disabled in the dashboard (and the API returns 503).
# For local stacks, you do not need to care.
POS_INTEGRATION_ENABLED="true"

# Public base URL for QR codes and absolute links. Use your LAN IP if you
# want phones on the same network to reach the kiosk.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SMS provider. "console" logs the SMS to stdout instead of sending.
SMS_PROVIDER="console"

